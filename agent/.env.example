# GST Keeper Portal Agent — environment
# Copy to .env and fill in. Keep this file OFF the office machine's backups /
# out of version control (already gitignored).

# Supabase (same project as the app: gcquafqxbykxkbexcdpy)
SUPABASE_URL=https://gcquafqxbykxkbexcdpy.supabase.co
# Service-role key — grants read of client credentials + write of job results.
# Store ONLY on the trusted office machine.
SUPABASE_SERVICE_ROLE_KEY=

# A stable id for this agent instance (used to claim jobs)
AGENT_ID=office-pc-1

# Poll interval (ms) for the job queue
POLL_INTERVAL_MS=4000

# Run the browser visibly (true) while developing/testing selectors, headless (false) in prod
HEADFUL=true

# Where to persist per-client login sessions + screenshots
DATA_DIR=./.agent-data
