# GST Keeper portal agent — environment. Copy to .env (install-agent.bat writes
# one for you). Day-to-day switches (on/off, schedule, how many browsers,
# keeping sessions, the e-mail trigger) are in the app: Notices -> Autopilot ->
# Settings. Keep this file on the office PC only (it is gitignored).

# A stable name for this agent (shown on the Autopilot page). Default: office-<computer name>
AGENT_ID=office-pc-1

# Show the browser windows (true, the default: an ordinary browser on the office PC,
# which staff can watch) or run them hidden (false).
HEADFUL=true

# The database. Leave both unset: the agent reads them from ../extension/config.js,
# the app's own publishable settings for project gcquafqxbykxkbexcdpy. No secret key
# is needed or wanted on this PC.
# SUPABASE_URL=https://gcquafqxbykxkbexcdpy.supabase.co
# SUPABASE_ANON_KEY=

# Encrypts portal sessions on this PC when "Keep portal sessions" is on in the app.
# Without it no session is kept. Any long random string; the installer generates one.
AGENT_SESSION_KEY=
# How long a kept session is tried again (minutes, default 50).
# SESSION_MAX_AGE_MIN=50

# Where logs, browser profiles and kept sessions live (default ./.agent-data).
# DATA_DIR=./.agent-data
# The extension folder (default ../extension).
# EXTENSION_DIR=../extension
# Browsers this PC may run at once (the app's setting decides, up to this; default 4).
# MAX_WORKERS=4
# One job's time budget in minutes (default 40) and the queue poll interval (ms).
# JOB_BUDGET_MIN=40
# POLL_INTERVAL_MS=5000

# Portal e-mail inbox (optional; read-only IMAP). See src/mail/README.md.
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
# IMAP_SECURE=true
# IMAP_USER=notices@yourfirm.com
# IMAP_PASSWORD=app-password
# IMAP_MAILBOX=INBOX
# IMAP_POLL_SECONDS=120
# Senders taken as the GST portal (regular expression; default gst.gov.in and its subdomains).
# PORTAL_SENDERS=@(?:[a-z0-9-]+\.)*gst\.gov\.in$
# Microsoft 365 mailboxes no longer accept a password over IMAP (they need OAuth, which the
# agent does not do): forward the portal e-mails to a mailbox that does, e.g. Google Workspace
# with an app password. See src/mail/README.md.

# Reading notices with the Claude API (optional). The API key of the firm's Anthropic
# account (console.anthropic.com -> API keys). Only this PC holds it: the app never sees
# it, and the agent never logs it. Empty: the notice reader stays off. Reading also needs
# the switch in the app (it ships off) and each client's consent on file. Sent to the API:
# the notice PDF, fixed instructions and the firm's issue codes; nothing about the client.
# See README.md, "Reading notices".
ANTHROPIC_API_KEY=
# How often the reader looks for notices to read (ms, default 15000).
# READER_POLL_MS=15000
