{
  "name": "gst-keeper-portal-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Office-PC worker for GST Keeper's Portal Autopilot: drives the GST Keeper extension in its own Chromium, CAPTCHAs typed by people on the app's CAPTCHA wall.",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
