{
  "manifest_version": 3,
  "name": "GST Keeper Portal Sync",
  "version": "0.1.0",
  "description": "Pulls GST portal data into GST Keeper from your own browser, so the portal treats it as a normal user (no server, no firewall block).",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://*.gst.gov.in/*",
    "https://gcquafqxbykxkbexcdpy.supabase.co/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "GST Keeper Sync"
  },
  "content_scripts": [
    {
      "matches": ["https://*.gst.gov.in/*"],
      "js": ["config.js", "db.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
